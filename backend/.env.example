# ==============================================================================
# 🚀 Smart Library Backend - Environment Configuration Template
# ==============================================================================
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Port on which the Express HTTP server listens
PORT=3000

# Client origin whitelist for Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# Supabase Cloud Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
SUPABASE_SERVICE_KEY=your_service_role_secret_key_here

# Direct PostgreSQL / Connection Pooler URI
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your-256-bit-jwt-secret-key-change-this-in-production
JWT_EXPIRATION=7d

# ------------------------------------------------------------------------------
# Operational Settings
# ------------------------------------------------------------------------------
TOTAL_LIBRARY_SEATS=350
SCAN_COOLDOWN_MS=5000
DEFAULT_LOG_LIMIT=20
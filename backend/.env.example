# ==============================================================================
# 🚀 Smart Library Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting the backend service:
#   cp .env.example .env
#
# Replace placeholder values with your project's actual credentials.
# Never commit the active '.env' file to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Port on which the Express HTTP server listens
PORT=3000

# Client origin whitelist for Cross-Origin Resource Sharing (CORS)
# Multiple origins can be comma-separated or configured in server.ts
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 2. Database / Supabase Cloud Configuration
# ------------------------------------------------------------------------------
# The unique REST API URL for your Supabase project
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (safe for browser / client apps)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key-placeholder

# Supabase Service Role Secret Key (REQUIRED FOR BACKEND SERVER)
# This key bypasses PostgreSQL Row-Level Security (RLS) for backend operations.
# NEVER expose this key in frontend code or commit to GitHub.
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key-placeholder

# Fallback alias for service role key (supported by legacy config modules)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key-placeholder

# Direct PostgreSQL / Connection Pooler URI (Optional for direct ORM or Prisma migrations)
# Transaction Pooler (Port 6543) or Session Pooler (Port 5432)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct database connection without pooler (Port 5432)
DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing administrative session tokens or webhooks
JWT_SECRET=your-256-bit-jwt-secret-key-change-this-in-production

# JWT token expiration window (e.g., '1d', '7d', '24h')
JWT_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. Library Business Logic & Operational Settings
# ------------------------------------------------------------------------------
# Total seating capacity enforced across all 4 library zones
TOTAL_LIBRARY_SEATS=350

# Duplicate scan debounce / cooldown window in milliseconds (5000ms = 5 seconds)
SCAN_COOLDOWN_MS=5000

# Default pagination limit for scan logs query
DEFAULT_LOG_LIMIT=20
